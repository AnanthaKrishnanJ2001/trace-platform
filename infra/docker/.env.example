# Copy this file to infra/docker/.env and fill in real values.
# Never commit the real .env file — it's covered by the root .gitignore.

# ---------- PostgreSQL ----------
POSTGRES_USER=trace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trace
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Internal service-to-service auth (TDD §1.2) ----------
# Shared secret used by Spring Boot Core to sign, and the FastAPI service to
# verify, the internal JWT. Rotate before any real deployment.
INTERNAL_JWT_SECRET=change-me-in-env

# ---------- FastAPI AI Service / Vertex AI (TDD §4.3) ----------
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1

# ---------- Spring profile ----------
SPRING_PROFILES_ACTIVE=local

# ---------- Gemini API (FastAPI AI Service) ----------
# Create a key at https://aistudio.google.com/apikey and put it in your local .env
# (never in this example file). Set only one of GEMINI_API_KEY / GOOGLE_API_KEY.
GEMINI_API_KEY=
